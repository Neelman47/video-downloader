# Dependencies
node_modules/
**/node_modules/

# Downloads directory (ignore user media, preserve empty folder)
downloads/*
!downloads/.gitkeep

# Local binaries (ignore downloaded binaries, preserve folder)
bin/*
!bin/.gitkeep

# Environment variables
.env
.env.local
.env.*.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# macOS system files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows system files
Thumbs.db
ehthumbs.db
desktop.ini

# Linux temporary files
*~
*.swp

# IDEs & editors
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Scratch files
notes.txt
